{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM role trust policy with a wildcard account id written without a resource suffix",
  "Resources": {
    "RoleWithSuffixlessWildcardAccount": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": "arn:aws:iam::*"
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
