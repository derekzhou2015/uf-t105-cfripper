{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM role trust policy built from a parameter that has a default value, so it resolves to a concrete account",
  "Parameters": {
    "AccountId": {
      "Type": "String",
      "Default": "123456789012"
    }
  },
  "Resources": {
    "RoleWithResolvedJoinPrincipal": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AccountId"
                      },
                      ":root"
                    ]
                  ]
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
