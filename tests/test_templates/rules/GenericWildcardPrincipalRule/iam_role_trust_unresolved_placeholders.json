{
  "AWSTemplateFormatVersion": "2010-09-09",
  "Description": "IAM role trust policies built from parameters that have no default values",
  "Parameters": {
    "AccountId": {
      "Type": "String"
    }
  },
  "Resources": {
    "RoleWithJoinPlaceholder": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Join": [
                    "",
                    [
                      "arn:aws:iam::",
                      {
                        "Ref": "AccountId"
                      },
                      ":root"
                    ]
                  ]
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    },
    "RoleWithSubPlaceholder": {
      "Type": "AWS::IAM::Role",
      "Properties": {
        "AssumeRolePolicyDocument": {
          "Version": "2012-10-17",
          "Statement": [
            {
              "Effect": "Allow",
              "Principal": {
                "AWS": {
                  "Fn::Sub": "arn:aws:iam::${AccountId}:root"
                }
              },
              "Action": "sts:AssumeRole"
            }
          ]
        }
      }
    }
  }
}
